# 依存パッケージ（npm install で復元できるためコミットしない）
node_modules/

# ビルド成果物（npm run build で生成されるためコミットしない）
dist/
dist-ssr/
playwright-report/
test-results/

# TypeScript のインクリメンタルビルドキャッシュ
*.tsbuildinfo

# ログ
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# エディタ / OS が生成するファイル
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code のローカル設定
.claude/

# Supabase ローカル開発の一時ファイル
supabase/.temp/
supabase/.branches/

# Expo ローカル状態
apps/mobile/.expo/
