# 検証用プロジェクトを管理者が確認するまで、値を設定して起動しない。
# repoルートの .staging-sync.local へ新規作成するための見本（*.local はgitignore対象）。
# このファイルは空欄のままでは事前診断に失敗する。
LIFE_QUEST_SYNC_TARGET=
LIFE_QUEST_STAGING_PROJECT_REF=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
LIFE_QUEST_APP_VARIANT=parity
LIFE_QUEST_PARITY_CAPTURE=
LIFE_QUEST_PARITY_PROFILE=
EXPO_NO_DOTENV=1
EXPO_NO_CLIENT_ENV_VARS=0
# URLと同じプロジェクトの公開publishableキー（またはanonキー）だけを使用する。
# 管理者キー・DB接続文字列・アカウントのパスワード・Apple秘密鍵は書かない。
