{
  "name": "antigravity-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:core": "npm run typecheck --workspace @life-quest/core",
    "check:secrets": "node scripts/check-service-role.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/core/src/db.types.ts",
    "db:test": "supabase test db",
    "e2e": "playwright test",
    "e2e:parity": "RUN_WEB_PARITY=1 playwright test --project=web-parity-390x844",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b --noEmit",
    "typecheck:core": "npm run typecheck --workspace @life-quest/core",
    "lint": "eslint .",
    "mobile:start": "npm run start --workspace @life-quest/mobile",
    "mobile:export": "npm run export:android --workspace @life-quest/mobile",
    "mobile:ios": "npm run ios:parity --workspace @life-quest/mobile",
    "mobile:parity:screenshots": "node scripts/run-mobile-parity-screenshots.mjs",
    "mobile:typecheck": "npm run typecheck --workspace @life-quest/mobile",
    "mobile:validate-release": "npm run validate:release-config --workspace @life-quest/mobile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:core": "npm run test --workspace @life-quest/core",
    "test:integration": "vitest run supabase/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@life-quest/core": "file:packages/core",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.0",
    "undici": "7.28.0"
  }
}
