{
  "name": "antigravity-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:core": "npm run typecheck --workspace @life-quest/core",
    "check:secrets": "node scripts/check-service-role.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/core/src/db.types.ts",
    "db:test": "supabase test db",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b --noEmit",
    "typecheck:core": "npm run typecheck --workspace @life-quest/core",
    "lint": "eslint .",
    "mobile:start": "npm run start --workspace @life-quest/mobile",
    "mobile:export": "npm run export:android --workspace @life-quest/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @life-quest/mobile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:core": "npm run test --workspace @life-quest/core",
    "test:integration": "vitest run supabase/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@life-quest/core": "file:packages/core",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.0",
    "undici": "7.28.0"
  }
}
