{
  "name": "antigravity-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:core": "npm run typecheck --workspace @life-quest/core",
    "typecheck": "tsc -b --noEmit",
    "typecheck:core": "npm run typecheck --workspace @life-quest/core",
    "lint": "eslint .",
    "mobile:start": "npm run start --workspace @life-quest/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @life-quest/mobile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:core": "npm run test --workspace @life-quest/core",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@life-quest/core": "file:packages/core",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.12",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
