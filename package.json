{
  "name": "antigravity-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:core": "npm run typecheck --workspace @life-quest/core",
    "check:secrets": "node scripts/check-service-role.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/core/src/db.types.ts",
    "db:test": "supabase test db",
    "e2e": "playwright test",
    "e2e:parity": "RUN_WEB_PARITY=1 playwright test --project=web-parity-390x844",
    "e2e:parity:reference": "RUN_WEB_PARITY=1 playwright test --project=web-reference-402x874",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b --noEmit",
    "typecheck:core": "npm run typecheck --workspace @life-quest/core",
    "lint": "eslint .",
    "mobile:start": "npm run start --workspace @life-quest/mobile",
    "mobile:export": "npm run export:android --workspace @life-quest/mobile",
    "mobile:ios": "npm run ios:parity --workspace @life-quest/mobile",
    "mobile:parity:screenshots": "node scripts/run-mobile-parity-screenshots.mjs",
    "mobile:parity:smoke": "node scripts/run-mobile-parity-screenshots.mjs smoke",
    "mobile:parity:progression": "node scripts/run-mobile-parity-screenshots.mjs progression",
    "mobile:start:anonymous": "npm run start:anonymous --workspace @life-quest/mobile",
    "mobile:parity:reference": "node scripts/run-mobile-parity-screenshots.mjs reference",
    "mobile:reference:dark": "npm run start:reference:dark --workspace @life-quest/mobile",
    "mobile:reference:light": "npm run start:reference:light --workspace @life-quest/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @life-quest/mobile",
    "mobile:validate-release": "npm run validate:release-config --workspace @life-quest/mobile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:core": "npm run test --workspace @life-quest/core",
    "test:integration": "vitest run supabase/integration",
    "test:sync": "node scripts/run-sync-quality.mjs",
    "test:sync:unit": "node scripts/run-sync-quality.mjs --unit",
    "sync:staging:check": "node scripts/check-staging-sync.mjs",
    "sync:staging:web": "node scripts/run-staging-sync.mjs web",
    "sync:staging:web:preview": "node scripts/run-staging-sync.mjs web-preview",
    "sync:staging:mobile": "node scripts/run-staging-sync.mjs mobile",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@life-quest/core": "file:packages/core",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@react-native/community-cli-plugin@0.86.3": {
      "metro": "0.84.6",
      "metro-config": "0.84.6",
      "metro-core": "0.84.6"
    },
    "@react-native/metro-config@0.86.3": {
      "metro-config": "0.84.6",
      "metro-runtime": "0.84.6"
    },
    "js-yaml": "4.3.2",
    "react-native-gesture-handler": "3.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "undici": "7.30.1"
  }
}
