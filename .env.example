# Supabase 接続情報（ローカル開発時は `npm run db:start` の出力値を使用）
# クライアントへ渡してよいのは URL と anon キーのみ。
# service_role キーは絶対にここへ書かない（ADR-007、npm run check:secrets が検査する）。

# Web (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# メール確認・パスワード再設定を使う場合は、Supabase Auth の Redirect URLs に
# http://localhost:5173/settings、http://127.0.0.1:5173/settings、lifequest://settings を追加する。
